{
  "name": "tableai-designaha",
  "version": "0.1.0",
  "private": true,
  "description": "Design systems for Table AI Alliance brands \u2014 DTCG tokens, build pipeline, and agent integrations.",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "build:tokens": "node build-tokens.ts",
    "build:site": "node scripts/build-site.ts",
    "sync:site": "node scripts/sync-site.ts",
    "sync:cloud-resources": "node scripts/sync-cloud-resources.ts",
    "sync:library": "node scripts/sync-public-library.ts --enrich",
    "enrich:library-logos": "node scripts/enrich-library-logos.ts --write",
    "seed:library": "node scripts/build-library-seed.ts",
    "process:adobe-assets": "node scripts/process-adobe-assets.ts",
    "assets:manifest": "node scripts/build-asset-manifest.ts",
    "assets:logos": "node scripts/enrich-logo-metadata.ts",
    "assets:migrate:dry": "node scripts/migrate-assets-to-r2.ts",
    "assets:migrate:upload": "node scripts/migrate-assets-to-r2.ts --upload",
    "assets:migrate:verify": "node scripts/migrate-assets-to-r2.ts --verify",
    "assets:import:opcglobal": "node scripts/import-opcglobal-assets.ts",
    "validate:assets": "node scripts/validate-asset-policy.ts",
    "validate:ip": "node scripts/validate-ip-system.ts",
    "validate:fonts": "node scripts/validate-font-library.ts",
    "validate:routes": "node scripts/validate-routes.ts",
    "check:production": "node scripts/check-production-health.ts",
    "deploy:cloudflare": "bash scripts/deploy-cloudflare.sh",
    "deploy:gh-pages": "bash scripts/publish-gh-pages.sh",
    "process:asset": "bash scripts/process-asset.sh",
    "sync:fonts": "node scripts/sync-font-library.ts && node scripts/archive-font-licenses.ts && node scripts/build-font-packages.ts",
    "sync:fonts:upload": "node scripts/sync-font-library.ts --upload && node scripts/archive-font-licenses.ts && node scripts/build-font-packages.ts --upload",
    "archive:font-licenses": "node scripts/archive-font-licenses.ts",
    "package:fonts": "node scripts/build-font-packages.ts",
    "sync:font-directory": "node scripts/sync-google-fonts-directory.ts",
    "seed:platform": "node scripts/build-platform-seed.ts",
    "encrypt:ksamint-skills": "node scripts/encrypt-private-skills.ts",
    "sync:skill": "cp KiND/tokens/kind.tokens.json .cursor/skills/kind-design/tokens.json",
    "sync:repositories": "node scripts/sync-repository-status.ts",
    "test:repositories": "node --test scripts/test/repository-status.test.ts",
    "test": "node --test scripts/test/*.test.ts",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.browser.json && tsc -p tsconfig.worker.json && tsc --noEmit -p mcp/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.1",
    "style-dictionary": "5.5.1",
    "typescript": "5.9.3",
    "wrangler": "4.121.0"
  },
  "dependencies": {
    "marked": "18.0.9"
  }
}
